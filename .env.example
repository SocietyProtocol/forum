# Discourse 2026.8.0-latest.1 on the AWS outpost.
# Production hostname is forum.societyprotocol.io.
# Staging hostname is staging-forum.societyprotocol.io.

DISCOURSE_HOSTNAME=forum.societyprotocol.io
DISCOURSE_FORCE_HTTPS=true
DISCOURSE_DEVELOPER_EMAILS=webmaster@societyprotocol.io
DISCOURSE_SECRET_KEY_BASE=REPLACE_WITH_LONG_RANDOM_SECRET
ADMIN_PASSWORD=REPLACE_ME
DISABLE_LETSENCRYPT=1
UNICORN_WORKERS=2

# Local Postgres and Redis on the AWS Docker network.
DISCOURSE_DB_HOST=prod-forum-postgres
DISCOURSE_DB_PORT=5432
DISCOURSE_DB_NAME=discourse
DISCOURSE_DB_USERNAME=discourse
DISCOURSE_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DISCOURSE_REDIS_HOST=prod-redis
DISCOURSE_REDIS_PORT=6379
DISCOURSE_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# Mail — leave placeholders until Mailgun/SP SMTP is in Bitwarden.
DISCOURSE_SMTP_ADDRESS=REPLACE_WITH_SMTP_HOST
DISCOURSE_SMTP_PORT=587
DISCOURSE_SMTP_USER_NAME=REPLACE_WITH_SMTP_USER
DISCOURSE_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
DISCOURSE_SMTP_ENABLE_START_TLS=true

# SIWE plugin (discourse-siwe-auth) — Graph must be the SP gateway later.
DISCOURSE_SIWE_SOCIETY_SUBGRAPH_URL=http://prod-gateway:8080/graphql
DISCOURSE_SIWE_PROJECT_ID=REPLACE_WITH_REOWN_PROJECT_ID
DISCOURSE_SIWE_ETHEREUM_RPC_URL=REPLACE_WITH_ALCHEMY_HTTPS_URL
