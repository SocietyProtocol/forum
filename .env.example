# Railway Discourse (placeholders until SMTP / backup exist)
# Current production forum.societyprotocol.io is unchanged.

DISCOURSE_HOSTNAME=REPLACE_WITH_RAILWAY_PUBLIC_DOMAIN
DISCOURSE_HOST=REPLACE_WITH_RAILWAY_PUBLIC_DOMAIN
DISCOURSE_FORCE_HTTPS=true
DISCOURSE_DEVELOPER_EMAILS=webmaster@societyprotocol.io
DISCOURSE_SECRET_KEY_BASE=REPLACE_WITH_LONG_RANDOM_SECRET
ADMIN_EMAIL=webmaster@societyprotocol.io
ADMIN_USERNAME=REPLACE_ME
ADMIN_PASSWORD=REPLACE_ME

# Wired from Railway Postgres / Redis after those services exist.
DISCOURSE_DB_HOST=${{Postgres.PGHOST}}
DISCOURSE_DB_PORT=${{Postgres.PGPORT}}
DISCOURSE_DB_NAME=${{Postgres.PGDATABASE}}
DISCOURSE_DB_USERNAME=${{Postgres.PGUSER}}
DISCOURSE_DB_PASSWORD=${{Postgres.PGPASSWORD}}
DISCOURSE_DATABASE_HOST=${{Postgres.PGHOST}}
DISCOURSE_DATABASE_PORT_NUMBER=${{Postgres.PGPORT}}
DISCOURSE_DATABASE_NAME=${{Postgres.PGDATABASE}}
DISCOURSE_DATABASE_USER=${{Postgres.PGUSER}}
DISCOURSE_DATABASE_PASSWORD=${{Postgres.PGPASSWORD}}
DISCOURSE_REDIS_HOST=${{Redis.REDISHOST}}
DISCOURSE_REDIS_PORT=${{Redis.REDISPORT}}
DISCOURSE_REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
DISCOURSE_REDIS_PORT_NUMBER=${{Redis.REDISPORT}}

# Mail — leave placeholders until Mailgun/SP SMTP is in Bitwarden.
DISCOURSE_SMTP_ADDRESS=REPLACE_WITH_SMTP_HOST
DISCOURSE_SMTP_PORT=587
DISCOURSE_SMTP_USER_NAME=REPLACE_WITH_SMTP_USER
DISCOURSE_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
DISCOURSE_SMTP_ENABLE_START_TLS=true

# SIWE plugin (discourse-siwe-auth) — Graph must be the SP gateway later.
DISCOURSE_SIWE_SOCIETY_SUBGRAPH_URL=https://query-gateway-v2-v2-candidate.up.railway.app/graphql
DISCOURSE_SIWE_PROJECT_ID=REPLACE_WITH_REOWN_PROJECT_ID
DISCOURSE_SIWE_ETHEREUM_RPC_URL=REPLACE_WITH_ALCHEMY_HTTPS_URL
