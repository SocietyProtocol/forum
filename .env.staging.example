# Template for a faithful staging twin of forum.societyprotocol.io.
# Placeholders only. Copy to a file outside git (on the box: /opt/society/env/),
# fill in every REPLACE_WITH_*, never reuse a value from the production env file.
# Explanations and the "why a hand-built test forum fails" list: docs/STAGING_ENV.md.

# --- Identity and HTTPS -------------------------------------------------------
# The SIWE message domain must equal this hostname (plugin rejects "Invalid domain").
DISCOURSE_HOSTNAME=staging-forum.societyprotocol.io
# Requires a TLS terminator (Cloudflare + Caddy) sending X-Forwarded-Proto: https.
DISCOURSE_FORCE_HTTPS=true
DISCOURSE_DEVELOPER_EMAILS=REPLACE_WITH_ADMIN_EMAIL
# Generate a fresh one for this environment: openssl rand -hex 64
DISCOURSE_SECRET_KEY_BASE=REPLACE_WITH_NEW_RANDOM_SECRET_NOT_PROD
ADMIN_PASSWORD=REPLACE_ME
DISABLE_LETSENCRYPT=1
UNICORN_WORKERS=2

# --- Own Postgres and Redis (never the production ones) ------------------------
DISCOURSE_DB_HOST=staging-forum-postgres
DISCOURSE_DB_PORT=5432
DISCOURSE_DB_NAME=discourse
DISCOURSE_DB_USERNAME=discourse
DISCOURSE_DB_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD
DISCOURSE_REDIS_HOST=staging-redis
DISCOURSE_REDIS_PORT=6379
DISCOURSE_REDIS_PASSWORD=REPLACE_WITH_STAGING_REDIS_PASSWORD

# --- Mail ----------------------------------------------------------------------
# Option 1, mail sink (Mailpit container on the same network, UI shows the mails):
DISCOURSE_SMTP_ADDRESS=REPLACE_WITH_MAILPIT_HOST
DISCOURSE_SMTP_PORT=1025
DISCOURSE_SMTP_AUTHENTICATION=none
DISCOURSE_SMTP_ENABLE_START_TLS=false
# Option 2, a real relay: set host/port/user/password and DISCOURSE_SMTP_ENABLE_START_TLS=true,
# and delete DISCOURSE_SMTP_AUTHENTICATION. With no SMTP at all, SIWE users stay inactive
# (see docs/STAGING_ENV.md, "Inactive SIWE users").
# DISCOURSE_SMTP_USER_NAME=REPLACE_WITH_SMTP_USER
# DISCOURSE_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD

# --- SIWE plugin: endpoints and secrets (Sepolia twin) -------------------------
# Each DISCOURSE_SIWE_* variable shadows the site setting of the same name
# (lower case, without the DISCOURSE_ prefix) and makes it read-only in the admin UI.
# Reown/WalletConnect project; staging-forum.societyprotocol.io must be in its domain allowlist.
DISCOURSE_SIWE_PROJECT_ID=REPLACE_WITH_REOWN_PROJECT_ID
# Mainnet RPC, used for signature verification (EIP-6492 needs it). Contains a key.
DISCOURSE_SIWE_ETHEREUM_RPC_URL=REPLACE_WITH_MAINNET_HTTPS_RPC_URL
# Society query gateway for staging (reads the Sepolia subgraph) and its bearer token.
DISCOURSE_SIWE_SOCIETY_SUBGRAPH_URL=http://staging-gateway:8080/graphql
DISCOURSE_SIWE_SOCIETY_SUBGRAPH_TOKEN=REPLACE_WITH_STAGING_GATEWAY_TOKEN
# Sepolia badges for group sync and gating.
DISCOURSE_SIWE_SOCIETY_BADGES_CONTRACT=0x12406bB6d11Cb641e100F1d8595c0C5e63F0bD47
DISCOURSE_SIWE_SOCIETY_BADGES_CHAIN_ID=11155111
DISCOURSE_SIWE_SOCIETY_BADGES_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Deliberately NOT set here, so Fritz can change them in the admin UI:
# siwe_group_sync_mode (start with "log"), siwe_group_badge_mapping, siwe_group_sync_exempt_usernames.
