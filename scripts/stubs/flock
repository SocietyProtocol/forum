#!/usr/bin/env python3
"""Test double for util-linux flock as used by the deploy script: flock -w SECONDS FD.

Locks the inherited descriptor with flock(2), exactly like the real binary, so
a second deploy really waits (or times out) while another holds the lock file.
"""
import fcntl
import os
import sys
import time

with open(os.path.join(os.environ["STUB_STATE"], "calls.log"), "a") as f:
    f.write("flock " + " ".join(sys.argv[1:]) + "\n")
args = sys.argv[1:]
timeout = float(args[args.index("-w") + 1])
fd = int(args[-1])
deadline = time.time() + timeout
while True:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        sys.exit(0)
    except OSError:
        if time.time() >= deadline:
            sys.exit(1)
        time.sleep(0.05)
