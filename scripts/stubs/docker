#!/usr/bin/env python3
"""Test double for the docker CLI used by test_deploy_pipeline.py.

State lives in $STUB_STATE/state.json (image tags -> ids, what is running).
Knobs (env): STUB_NEW_ID, STUB_BUILD_FAIL, STUB_COMPOSE_FAIL, STUB_HEALTH (ok|bad),
STUB_IMAGE (the tag compose runs), STUB_PLUGIN_SHA, STUB_LABEL_SHA.
"""
import json
import os
import sys

S = os.environ["STUB_STATE"]
STATE = os.path.join(S, "state.json")
args = sys.argv[1:]
with open(os.path.join(S, "calls.log"), "a") as f:
    f.write("docker " + " ".join(args) + "\n")
st = json.load(open(STATE)) if os.path.exists(STATE) else {"tags": {}, "order": [], "running": ""}


def save():
    json.dump(st, open(STATE, "w"))


def settag(ref, ident):
    st["tags"][ref] = ident
    if ref in st["order"]:
        st["order"].remove(ref)
    st["order"].append(ref)


def flagval(a, flag):
    return a[a.index(flag) + 1] if flag in a else None


cmd = args[0] if args else ""
if cmd == "image" and args[1] == "inspect":
    rest = args[2:]
    if rest and rest[0] == "-f":
        rest = rest[2:]
    ident = st["tags"].get(rest[0])
    if not ident:
        sys.exit(1)
    print(ident)
elif cmd == "image" and args[1] == "ls":
    repo = args[2]
    seen = []
    for ref in reversed(st["order"]):
        r, _, t = ref.rpartition(":")
        if r == repo and ref in st["tags"] and t not in seen:
            seen.append(t)
    print("\n".join(seen))
elif cmd == "rmi":
    ref = args[1]
    if st["tags"].get(ref) and st["tags"][ref] == st["running"] and sum(1 for v in st["tags"].values() if v == st["running"]) == 1:
        sys.stderr.write("conflict: image in use\n")
        sys.exit(1)
    st["tags"].pop(ref, None)
    save()
elif cmd == "tag":
    settag(args[2], st["tags"].get(args[1], args[1]))
    save()
elif cmd == "build":
    if os.environ.get("STUB_BUILD_FAIL"):
        sys.stderr.write("build failed\n")
        sys.exit(1)
    ident = os.environ.get("STUB_NEW_ID", "sha256:new")
    ctx = args[-1]
    if not os.path.isfile(os.path.join(ctx, "Dockerfile")):
        sys.stderr.write("no Dockerfile in build context %s\n" % ctx)
        sys.exit(1)
    i = 0
    while i < len(args):
        if args[i] == "-t":
            settag(args[i + 1], ident)
            i += 1
        i += 1
    save()
elif cmd == "compose":
    if os.environ.get("STUB_COMPOSE_FAIL"):
        sys.exit(1)
    st["running"] = st["tags"].get(os.environ.get("STUB_IMAGE", ""), st["running"])
    save()
elif cmd == "ps":
    if st["running"]:
        print("c1")
elif cmd == "inspect":
    fmt = args[2]
    if "State.Running" in fmt:
        print("true")
    elif "Labels" in fmt:
        print(os.environ.get("STUB_LABEL_SHA", os.environ.get("STUB_PLUGIN_SHA", "")))
    elif ".Image" in fmt:
        print(st["running"])
elif cmd == "exec":
    joined = " ".join(args)
    if " curl " in joined:
        if os.environ.get("STUB_HEALTH", "ok") != "ok":
            sys.exit(22)
        print("ok")
    elif " grep " in joined:
        print("# version: 0.0.0-test")
    elif "rev-parse" in joined:
        print(os.environ.get("STUB_PLUGIN_SHA", ""))
elif cmd == "logs":
    print("stub log line")
